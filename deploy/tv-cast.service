[Unit]
Description=TV Cast
After=network-online.target
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__DIR__
ExecStart=__DIR__/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 80
# 80 portunu root olmadan kullanabilmek için
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
