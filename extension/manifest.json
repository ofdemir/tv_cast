{
  "manifest_version": 3,
  "name": "TV Cast gönderici",
  "version": "1.0.0",
  "description": "Sayfada oynayan videonun linkini (m3u8/mp4) evdeki TV Cast sunucusuna gönderir.",
  "permissions": ["webRequest", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TV Cast",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
